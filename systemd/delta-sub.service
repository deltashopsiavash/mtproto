[Unit]
Description=Delta MTProto Sub Pages
After=network.target

[Service]
WorkingDirectory=/opt/delta-proxy-panel
EnvironmentFile=/opt/delta-proxy-panel/.env
Environment=APP_DIR=/opt/delta-proxy-panel
ExecStart=/opt/delta-proxy-panel/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${SUB_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
